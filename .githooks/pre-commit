#!/bin/sh
# Sneakaboo pre-commit: scan staged changes for secrets if gitleaks is installed.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --config .gitleaks.toml --redact --verbose || {
    echo "pre-commit: gitleaks found possible secrets. Commit blocked." >&2
    exit 1
  }
else
  echo "pre-commit: WARNING gitleaks not installed, skipping secret scan (https://github.com/gitleaks/gitleaks)." >&2
fi
exit 0
